# MIABÉ CTF — modèle de configuration.
# Copier vers .env et renseigner les valeurs. Ne jamais committer .env.

# --- Application ---
# Environnement : development, test ou production.
APP_ENV=development
# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Origines autorisées pour CORS, séparées par des virgules.
CORS_ORIGINS=http://localhost:3000

# --- Base de données ---
# Connexion applicative FastAPI (rôle sans droits DDL, voir ADR 002).
DATABASE_URL=postgresql+asyncpg://miabe_backend:change-me@localhost:54322/postgres
# Connexion utilisée uniquement par les migrations Alembic.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:54322/postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Supabase (serveur) ---
# URL du projet, sans barre oblique finale.
SUPABASE_URL=http://localhost:54321
# Mode de vérification des JWT : jwks (défaut) ou remote (projet en secret partagé, voir ADR 002).
SUPABASE_AUTH_MODE=jwks
# Clé secrète Supabase. Serveur uniquement, jamais côté frontend.
SUPABASE_SECRET_KEY=

# --- CTFd ---
# Clé Fernet de chiffrement des tokens CTFd.
CTFD_TOKEN_ENCRYPTION_KEY=

# --- Docker Compose : CTFd de développement ---
# Clé de session de l'instance CTFd locale.
CTFD_SECRET_KEY=change-me

# --- Frontend (exposé au navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Clé publique Supabase. Ne jamais y mettre la clé secrète.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL publique de l'API FastAPI.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Active le bouton de connexion Google : true ou false.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
